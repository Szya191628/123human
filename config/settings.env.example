# 复制为 settings.env；此文件仅配置部署脚本，不等于 LiveStream 的系统配置。
MODEL=wav2lip
AVATAR_ID=wav2lip256_avatar1
TRANSPORT=webrtc
LIVETALKING_URL=http://127.0.0.1:8010
LIVESTREAM_URL=http://127.0.0.1:8020
LT_PORT=8010
LS_PORT=8020
# LiveTalking 最新 README 的参考版本；如果显卡驱动不支持 CUDA 12.8，请根据 PyTorch 官方兼容表调整
PYTORCH_VERSION=2.9.1
TORCHVISION_VERSION=0.24.1
TORCHAUDIO_VERSION=2.9.1
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# 可选参数（例：--tts edgetts --batch_size 8）
LT_EXTRA_ARGS=
